# Example env file. Copy to `.env.local` and replace values with real secrets.

# Supabase (public) - used by the client/browser
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=pk.your_public_anon_key_here

# Supabase service role key (server-only). Keep this secret and do NOT commit real values.
SUPABASE_SERVICE_ROLE_KEY=sk.your_service_role_key_here

# App base URL (used for building referral links)
NEXT_PUBLIC_BASE_URL=https://your-app.example.com

# Token for uploading blobs (server-only)
BLOB_READ_WRITE_TOKEN=your-blob-read-write-token

# SMTP settings for sending emails (server-only). Fill with your SMTP provider details.
# For Gmail with App Passwords: use smtp.gmail.com and port 587 with SMTP_SECURE=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Set to "true" for SSL/TLS (usually 465) or "false" for STARTTLS (usually 587)
SMTP_SECURE=false
SMTP_USER=your_smtp_username_or_email
SMTP_PASS=your_smtp_password_or_app_password
# Optional: the From header shown in outgoing emails
SMTP_FROM="Hostiggo <no-reply@yourdomain.com>"
